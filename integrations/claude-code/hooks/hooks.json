{
  "description": "Shows the Revefi sign-in and report links whatever the model writes",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(revefi-agent-analyzer *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/lib/revefi-agent-analyzer.js", "hook"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(revefi-agent-analyzer *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/lib/revefi-agent-analyzer.js", "hook"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
