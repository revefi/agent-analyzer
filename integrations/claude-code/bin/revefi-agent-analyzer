#!/bin/sh
# Runs the bundled CLI with the user's Node, after checking Node is new enough.
set -e
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if ! command -v node >/dev/null 2>&1; then
  echo "revefi-agent-analyzer needs Node.js 22.12 or newer, and node isn't on your PATH." >&2
  echo "Install Node from https://nodejs.org, then run this again." >&2
  exit 127
fi
if ! node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=12)?0:1)'; then
  echo "revefi-agent-analyzer needs Node.js 22.12 or newer; you have $(node --version). Update Node from https://nodejs.org." >&2
  exit 1
fi
exec node "$here/../lib/revefi-agent-analyzer.js" "$@"
